# Build context minimization for root Dockerfile (backend-only deploy)
.git
.gitignore
Dockerfile
.dockerignore
client
docs

# Never include secrets or local artifacts
**/.env
**/.env.*
!**/.env.example

**/node_modules
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Server dev/test artifacts not required at runtime
server/tests
server/.gitignore
server/.env
server/.env.*
server/node_modules

# OS/editor noise
**/.DS_Store
**/Thumbs.db
.vscode
.idea
