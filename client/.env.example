# ---------------------------------------------------------------------------
# Website API (SoilMate website: /explore, /farm, /lab, /compare, /dashboard).
# Host only: no /api suffix and no trailing slash. Local example only.
# On Vercel, set this in Project Settings -> Environment Variables, then redeploy
# (NEXT_PUBLIC_* values are embedded at build time).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Use stage-local mocks for website endpoints marked [PLANNED], plus the
# development-only auth mock in lib/auth/mock.ts while the auth API is absent.
# Set to true only while those endpoints are unavailable; false is the default.
NEXT_PUBLIC_MOCK_PLANNED=false

# ---------------------------------------------------------------------------
# Explore Land base maps.
# Street map: the OpenStreetMap standard tiles (no key, attribution shown).
# Satellite: the public Esri World Imagery tiles by default (no key, attribution
# shown). Point it at another provider if you prefer one, for example a keyed
# one: NEXT_PUBLIC_SATELLITE_TILE_URL=https://api.maptiler.com/tiles/satellite/
# {z}/{x}/{y}.png?key=YOUR_KEY and NEXT_PUBLIC_SATELLITE_ATTRIBUTION="© Your
# provider". Set NEXT_PUBLIC_SATELLITE_TILE_URL to an empty value to switch
# satellite imagery off; the UI then says so instead of faking a layer.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SATELLITE_TILE_URL=
# NEXT_PUBLIC_SATELLITE_ATTRIBUTION=

# ---------------------------------------------------------------------------
# Learn & Play Game API (unchanged; the game keeps its own X-Player-Id helper).
# This is the full API prefix, unlike NEXT_PUBLIC_API_BASE above.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api
